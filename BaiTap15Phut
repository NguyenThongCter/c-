        private void btnXuatThongTin_Click(object sender, EventArgs e)
        {
            string hoTen = txtHoTen.Text;
            DateTime ngaySinh = dtpNgaySinh.Value;

            String gioiTinh = rdoNam.Checked ? "Nam" : "Nữ";

            List<string> dsSoThich = new List<string>();
            if (chkTheThao.Checked) dsSoThich.Add("The thao");
            if (chkPhimAnh.Checked) dsSoThich.Add("Phim anh");
            if (chkDuLich.Checked) dsSoThich.Add("Du lich");

            string soThich = string.Join(", ", dsSoThich);

            string thongTin = $"Ho ten: {hoTen}, Gioi tinh: {gioiTinh}, Ngay sinh: {ngaySinh}, So thich: {soThich}";

            MessageBox.Show(thongTin, "Thong tin nguoi dung");
        }
